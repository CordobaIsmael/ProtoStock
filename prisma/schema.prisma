// Prisma schema for LocalKioskito (compatible with SQLite & PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id           String    @id @default(uuid())
  slug         String    @unique // Identificador único: emporio-del-sabor, kiosco-trebol
  name         String    // Nombre del Comercio / Almacén
  taxId        String?   // CUIT
  phone        String?
  email        String?
  address      String?
  plan         String    @default("PRO") // STARTER, PRO, ENTERPRISE
  status       String    @default("ACTIVO") // ACTIVO, SUSPENDIDO_POR_PAGO, INACTIVO
  dueDate      DateTime? // Fecha de vencimiento de la cuota mensual
  monthlyFee   Float     @default(25000.0) // Cuota mensual pactada en ARS
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  users      User[]
  categories Category[]
  products   Product[]
  cashShifts CashShift[]
  sales      Sale[]
  purchases  Purchase[]
  suppliers  Supplier[]
}

model User {
  id           String   @id @default(uuid())
  tenantId     String?
  name         String
  username     String   @unique
  email        String?  @unique
  passwordHash String
  role         String   @default("CAJERO") // SUPERADMIN, ADMIN, ENCARGADO, CAJERO
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant         Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashShifts     CashShift[]
  cashMovements  CashMovement[]
  sales          Sale[]
  purchases      Purchase[]
  stockMovements StockMovement[]
  auditLogs      AuditLog[]
}

model Category {
  id          String   @id @default(uuid())
  tenantId    String?
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant        Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subcategories Subcategory[]
  products      Product[]
}

model Subcategory {
  id          String   @id @default(uuid())
  categoryId  String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([categoryId, name])
}

model Product {
  id                 String   @id @default(uuid())
  tenantId           String?
  code               String?  @unique // Código de barras o SKU interno
  name               String
  description        String?
  categoryId         String
  subcategoryId      String?
  unitType           String   @default("UNIDAD") // UNIDAD, KG, GRAMO, LITRO, PAQUETE, CAJA
  isWeighted         Boolean  @default(false) // Si se fracciona/pesa (balanza)
  costPrice          Float    @default(0.0)
  salePrice          Float    @default(0.0)
  minStock           Float    @default(0.0)
  currentStock       Float    @default(0.0)
  allowStockNegative Boolean  @default(false)
  requiresExpiration Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant         Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category       Category        @relation(fields: [categoryId], references: [id])
  subcategory    Subcategory?    @relation(fields: [subcategoryId], references: [id])
  batches        Batch[]
  stockMovements StockMovement[]
  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]
}

model Batch {
  id              String    @id @default(uuid())
  productId       String
  batchNumber     String?
  expirationDate  DateTime?
  initialQuantity Float
  currentQuantity Float
  costPrice       Float
  supplierId      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier       Supplier?       @relation(fields: [supplierId], references: [id])
  stockMovements StockMovement[]
  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]
}

model StockMovement {
  id            String   @id @default(uuid())
  productId     String
  batchId       String?
  movementType  String   // COMPRA, VENTA, AJUSTE, DEVOLUCION, MERMA, INICIAL
  quantity      Float
  previousStock Float
  newStock      Float
  reason        String?
  userId        String?
  createdAt     DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  batch   Batch?  @relation(fields: [batchId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])
}

model CashShift {
  id             String    @id @default(uuid())
  tenantId       String?
  userId         String
  openingDate    DateTime  @default(now())
  closingDate    DateTime?
  initialAmount  Float
  expectedAmount Float     @default(0.0)
  actualAmount   Float?
  difference     Float?
  status         String    @default("ABIERTA") // ABIERTA, CERRADA
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id])
  cashMovements CashMovement[]
  sales         Sale[]
}

model CashMovement {
  id          String   @id @default(uuid())
  cashShiftId String
  type        String   // INGRESO, EGRESO, VENTA, DEVOLUCION
  amount      Float
  concept     String
  userId      String
  createdAt   DateTime @default(now())

  cashShift CashShift @relation(fields: [cashShiftId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])
}

model Supplier {
  id        String   @id @default(uuid())
  tenantId  String?
  name      String
  taxId     String? // CUIT / CUIL
  phone     String?
  email     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchases Purchase[]
  batches   Batch[]
}

model Purchase {
  id            String   @id @default(uuid())
  tenantId      String?
  supplierId    String
  invoiceNumber String?
  totalAmount   Float
  status        String   @default("COMPLETADA") // PENDIENTE, COMPLETADA, CANCELADA
  notes         String?
  userId        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant   Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier       @relation(fields: [supplierId], references: [id])
  user     User           @relation(fields: [userId], references: [id])
  items    PurchaseItem[]
}

model PurchaseItem {
  id         String  @id @default(uuid())
  purchaseId String
  productId  String
  batchId    String?
  quantity   Float
  unitCost   Float
  subtotal   Float

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
  batch    Batch?   @relation(fields: [batchId], references: [id])
}

model Sale {
  id            String   @id @default(uuid())
  tenantId      String?
  saleNumber    Int      @unique
  cashShiftId   String?
  userId        String
  customerName  String?  @default("Consumidor Final")
  totalAmount   Float
  discount      Float    @default(0.0)
  paymentMethod String   @default("EFECTIVO") // EFECTIVO, TARJETA_DEBITO, TARJETA_CREDITO, TRANSFERENCIA, MULTIPLE
  status        String   @default("COMPLETADA") // COMPLETADA, ANULADA
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashShift CashShift? @relation(fields: [cashShiftId], references: [id])
  user      User       @relation(fields: [userId], references: [id])
  items     SaleItem[]
}

model SaleItem {
  id        String @id @default(uuid())
  saleId    String
  productId String
  batchId   String?
  quantity  Float
  unitPrice Float
  subtotal  Float
  unitType  String @default("UNIDAD")

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  batch   Batch?  @relation(fields: [batchId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}
